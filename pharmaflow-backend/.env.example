# PharmaFlow — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — this file (.env.example) is the one that gets committed.

# MySQL connection string
# Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/pharmaflow

# JWT secret — must be a long random string (min 32 characters)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-secret

# JWT token expiry in minutes (default: 480 = 8 hours = one full shift)
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins — no trailing slash
ALLOWED_ORIGINS=http://localhost:3000
